<%- include('partials/header') %>

<div class="form-container">
    <h2 style="margin-bottom: 1.5rem;">Add New Resource</h2>
    <% if (error) { %>
        <div class="alert alert-danger" id="error-alert" style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem;">
            <span><%= error %></span>
            <button onclick="document.getElementById('error-alert').style.display='none'" 
                style="background:none; border:none; color:inherit; font-size:1.2rem; cursor:pointer; flex-shrink:0; line-height:1; opacity:0.7;" 
                title="Close">✕</button>
        </div>
    <% } %>
    <form action="/admin/resource/add" method="POST" enctype="multipart/form-data" id="resource-form">
        <div class="form-group">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" required>
        </div>
        <div class="form-group">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"></textarea>
        </div>
        
        <!-- URL Input -->
        <div class="form-group" id="url-group">
            <label class="form-label">URL (Link or File Path)</label>
            <input type="text" name="url" id="url-input" class="form-control" placeholder="https://...">
            <div style="margin-top: 0.5rem; padding: 0.6rem 0.8rem; border-radius: 6px; background: rgba(66,133,244,0.08); border: 1px solid rgba(66,133,244,0.2); font-size: 0.82rem; color: #4285f4;">
                💡 <strong>Google Drive PDF?</strong> Share link paste karo — PDF automatically website ke andar embed ho jaayega!
                <br><span style="opacity:0.8; font-size: 0.78rem;">Example: https://drive.google.com/file/d/FILE_ID/view?usp=sharing</span>
            </div>
        </div>

        <!-- File Upload Input (Hidden by default) -->
        <div class="form-group" id="file-group" style="display: none;">
            <label class="form-label">
                Upload PDF
                <span style="font-size:0.8rem; color: var(--text-muted); margin-left: 0.5rem;">
                    (Max: 10MB — Cloudinary Free Plan limit)
                </span>
            </label>
            <input type="file" name="pdf" id="file-input" class="form-control" accept="application/pdf">
            <!-- File size warning box -->
            <div id="file-size-warning" style="display:none; margin-top:0.75rem; padding:0.75rem 1rem; border-radius:8px; font-size:0.9rem;"></div>
        </div>

        <div class="grid" style="margin-top: 0; gap: 1rem;">
            <div class="form-group">
                <label class="form-label">Type</label>
                <select name="type" id="type-select" class="form-control" onchange="toggleInput()">
                    <option value="video">Video</option>
                    <option value="article">Article</option>
                    <option value="pdf">PDF</option>
                    <option value="link">External Link</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Category</label>
                <input type="text" name="category" class="form-control" list="category-list" required placeholder="Select or Type Category">
                <datalist id="category-list">
                    <option value="HTML">
                    <option value="CSS">
                    <option value="Javascript">
                    <option value="Node.js">
                    <option value="MongoDB">
                    <option value="Projects">
                    <option value="React">
                    <option value="Angular">
                    <option value="Vue">
                    <option value="Python">
                    <option value="Java">
                    <option value="C++">
                </datalist>
            </div>
        </div>
        
        <button type="submit" id="submit-btn" class="btn btn-success" style="width: 100%; background-color: var(--success); color: white;">Add Resource</button>

    <script>
        const CLOUDINARY_FREE_LIMIT_MB = 10;   // Cloudinary free plan raw file limit
        const HARD_LIMIT_MB = 50;              // Our multer hard limit

        function toggleInput() {
            const type = document.getElementById('type-select').value;
            const urlGroup = document.getElementById('url-group');
            const fileGroup = document.getElementById('file-group');
            const urlInput = document.getElementById('url-input');

            if (type === 'pdf') {
                urlGroup.style.display = 'none';
                fileGroup.style.display = 'block';
                urlInput.required = false;
            } else {
                urlGroup.style.display = 'block';
                fileGroup.style.display = 'none';
                urlInput.required = true;
                clearFileSizeWarning();
            }
        }

        function clearFileSizeWarning() {
            const warn = document.getElementById('file-size-warning');
            warn.style.display = 'none';
            warn.innerHTML = '';
        }

        document.getElementById('file-input').addEventListener('change', function() {
            const file = this.files[0];
            const warn = document.getElementById('file-size-warning');
            const submitBtn = document.getElementById('submit-btn');

            if (!file) { clearFileSizeWarning(); return; }

            const sizeInMB = (file.size / (1024 * 1024)).toFixed(2);

            if (file.size > HARD_LIMIT_MB * 1024 * 1024) {
                // BLOCK: above our server limit
                warn.style.display = 'block';
                warn.style.background = 'rgba(239,68,68,0.15)';
                warn.style.border = '1px solid rgba(239,68,68,0.3)';
                warn.style.color = '#ef4444';
                warn.innerHTML = `❌ <strong>${sizeInMB} MB</strong> — File ${HARD_LIMIT_MB}MB se zyada hai. Ye upload nahi hoga.`;
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.5';
            } else if (file.size > CLOUDINARY_FREE_LIMIT_MB * 1024 * 1024) {
                // WARN: above Cloudinary free limit
                warn.style.display = 'block';
                warn.style.background = 'rgba(245,158,11,0.15)';
                warn.style.border = '1px solid rgba(245,158,11,0.3)';
                warn.style.color = '#f59e0b';
                warn.innerHTML = `⚠️ <strong>${sizeInMB} MB</strong> — Cloudinary Free Plan sirf <strong>10MB</strong> allow karta hai. Ye file upload fail ho sakti hai.<br><small style="opacity:0.8">Cloudinary plan upgrade karein ya 10MB se choti PDF use karein.</small>`;
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
            } else {
                // OK range
                warn.style.display = 'block';
                warn.style.background = 'rgba(16,185,129,0.15)';
                warn.style.border = '1px solid rgba(16,185,129,0.3)';
                warn.style.color = '#10b981';
                warn.innerHTML = `✅ <strong>${sizeInMB} MB</strong> — File size theek hai.`;
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
            }
        });

        // Run on load to set initial state
        toggleInput();
    </script>
        <a href="/admin/dashboard" class="btn btn-outline" style="width: 100%; margin-top: 1rem; text-align: center;">Cancel</a>
    </form>
</div>

<%- include('partials/footer') %>

