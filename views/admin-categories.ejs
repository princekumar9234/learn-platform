<%- include('partials/header') %>

<div class="container">
    <div class="page-header">
        <h1>Manage Categories</h1>
        <a href="/admin/dashboard" class="btn btn-outline">&#8592; Back to Dashboard</a>
    </div>

    <% if (success) { %>
        <div class="alert alert-success" style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem; margin-bottom:1.5rem;">
            <span>✅ <%= success.replace(/\+/g, ' ') %></span>
            <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;color:inherit;font-size:1.2rem;cursor:pointer;opacity:0.7;">✕</button>
        </div>
    <% } %>

    <div class="card" style="margin-bottom: 2rem; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);">
        <p style="color: var(--text-muted); font-size: 0.95rem;">
            <strong style="color: var(--text-main);">Password Protection:</strong> Setting a password requires users to enter it before seeing resources in that category. Leave blank to disable.<br>
            <strong style="color: var(--text-main); margin-top: 0.4rem; display: inline-block;">Rename / Merge:</strong> Rename a category to another existing name to <em>merge</em> both into one.
        </p>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Status</th>
                    <th>Password</th>
                    <th>Rename / Merge</th>
                </tr>
            </thead>
            <tbody>
                <% categories.forEach(cat => { %>
                    <tr>
                        <td style="font-weight: 600; color: var(--primary);"><%= cat.name %></td>
                        <td>
                            <% if (cat.password) { %>
                                <span class="status-badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);">
                                    <ion-icon name="lock-closed-outline" style="vertical-align: middle; margin-right: 4px;"></ion-icon>Protected
                                </span>
                            <% } else { %>
                                <span class="status-badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);">
                                    <ion-icon name="lock-open-outline" style="vertical-align: middle; margin-right: 4px;"></ion-icon>Public
                                </span>
                            <% } %>
                        </td>
                        <td>
                            <form action="/admin/categories/update-password" method="POST" class="category-password-form">
                                <input type="hidden" name="categoryId" value="<%= cat._id %>">
                                <input type="text" name="password" placeholder="No password set" value="<%= cat.password || '' %>" class="category-password-input">
                                <button type="submit" class="btn btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">Save</button>
                            </form>
                        </td>
                        <td>
                            <form action="/admin/categories/rename" method="POST" class="category-password-form"
                                onsubmit="return confirmRename(this)">
                                <input type="hidden" name="categoryId" value="<%= cat._id %>">
                                <input type="text" name="newName" placeholder="New name..."
                                    value="<%= cat.name %>"
                                    class="category-password-input"
                                    list="cat-name-list-<%= cat._id %>">
                                <datalist id="cat-name-list-<%= cat._id %>">
                                    <% categories.forEach(c => { %>
                                        <% if (c._id.toString() !== cat._id.toString()) { %>
                                            <option value="<%= c.name %>">
                                        <% } %>
                                    <% }) %>
                                </datalist>
                                <button type="submit" class="btn btn-warning" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background:#f59e0b; color:white;">Rename</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                <% if (categories.length === 0) { %>
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 2rem; color: var(--text-muted);">No categories found. Add resources to see categories here.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
function confirmRename(form) {
    const input = form.querySelector('input[name="newName"]');
    const hidden = form.querySelector('input[name="categoryId"]');
    const newName = input.value.trim();
    const currentName = input.defaultValue.trim();

    if (!newName) { alert('Name cannot be empty.'); return false; }
    if (newName === currentName) return false;

    // Check if it matches another existing category (merge warning)
    const allOptions = Array.from(input.list ? input.list.options : []).map(o => o.value);
    if (allOptions.includes(newName)) {
        return confirm(
            `"${newName}" category already exists!\n\nDo you want to MERGE "${currentName}" into "${newName}"?\n\nAll resources from "${currentName}" will move to "${newName}".`
        );
    }
    return confirm(`Rename "${currentName}" to "${newName}"?`);
}
</script>

<%- include('partials/footer') %>
